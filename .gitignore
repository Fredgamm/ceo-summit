# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# lib/r2.ts local dev fallback (R2 credentials absent) — files written to disk
/.local-storage/

# deploy/backup.sh output on the VPS — never committed
/backups/

# next-pwa — generated service worker (E9-T01), rebuilt on every `next build`
/public/sw.js
/public/sw.js.map
/public/workbox-*.js
/public/worker-*.js
/public/fallback-*.js

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — real secrets excluded, but .env.example/.env.production.example
# are committed templates (the README's/DEPLOY.md's setup steps assume they
# exist in the repo)
.env
.env.*
!.env.example
!.env.production.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# Docker daemon data-root relocated here on the shared VPS (see DEPLOY.md) —
# never committed, just runtime state (images/containers/volumes).
/.docker-data/

# Documentation de conception (restaurée de l'ancien dépôt parent le 13 oct. 2026) :
# captures d'écran personnelles non versionnées.
/docs/*.png
