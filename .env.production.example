# Modèle pour la config de prod sur le VPS — copier vers `.env` (bien
# `.env`, pas `.env.production` : Docker Compose lit automatiquement un
# fichier nommé exactement `.env` dans le même dossier que le compose file,
# à la fois pour la substitution ${VAR} et — via `env_file: .env` dans
# docker-compose.prod.yml — pour l'injecter dans les conteneurs. Avec un
# autre nom, il faudrait ajouter `--env-file` à CHAQUE commande `docker
# compose`, ce qui a été testé et oublié une fois pendant la préparation de
# ce guide : mieux vaut l'éviter structurellement.
# Ce fichier ne doit JAMAIS être committé (voir .gitignore) : c'est un
# modèle, pas le fichier réel.
#
# Différences avec .env.example (dev local) :
# - DATABASE_URL / REDIS_URL pointent vers les noms de service Docker
#   (postgres, redis), pas localhost — les conteneurs se joignent sur le
#   réseau Docker interne créé par docker-compose.prod.yml.
# - NEXTAUTH_URL / NEXT_PUBLIC_SOCKET_URL pointent vers l'IP publique du VPS
#   (même origine pour les deux : Nginx route /socket.io/ vers le bon
#   conteneur en interne — voir deploy/nginx.conf).

# ── Database ──
POSTGRES_USER="ceosummit"
POSTGRES_PASSWORD="CHANGE_ME_avec_un_mot_de_passe_genere_aleatoirement"
DATABASE_URL="postgresql://ceosummit:CHANGE_ME_meme_mot_de_passe_que_ci-dessus@postgres:5432/ceo_summit?schema=public"

# ── Redis (cache + Socket.io Pub/Sub) ──
REDIS_URL="redis://redis:6379"

# ── Auth (NextAuth v5) ──
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME"
# IP du VPS pour l'instant (pas de domaine encore) — à remplacer par
# https://votre-domaine.tld une fois le domaine + certificat en place.
NEXTAUTH_URL="http://167.114.96.153"

# ── Salles thématiques — serveur Socket.io autonome ──
SOCKET_PORT="3001"
# Même origine que NEXTAUTH_URL : Nginx route /socket.io/ vers le conteneur
# socket en interne, le navigateur ne voit qu'une seule origine publique.
NEXT_PUBLIC_SOCKET_URL="http://167.114.96.153"

# ── Paiement — webhook de confirmation générique (7 août 2026) ──
PAYMENT_WEBHOOK_SECRET="ask-ceo-summit-for-sandbox-hmac-secret"

# ── Email transactionnel — Resend ──
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="noreply@ceosummit.mg"
ADMIN_ALERT_EMAIL="admin@ceosummit.mg"
RESEND_WEBHOOK_SECRET="ask-ceo-summit-for-sandbox-hmac-secret"

# ── Stockage fichiers — Cloudflare R2 (S3-compatible) ──
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_AVATARS="ceo-summit-avatars"
R2_BUCKET_DOCUMENTS="ceo-summit-documents"
R2_BUCKET_EVENTS="ceo-summit-event-assets"
R2_PUBLIC_URL="https://assets.ceosummit.mg"

# ── Zoom (webinaires) ──
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# ── Messages privés — chiffrement pgcrypto ──
# Générer avec : openssl rand -hex 32
MESSAGE_ENCRYPTION_KEY="CHANGE_ME"

# ── App ──
NODE_ENV="production"
