# ── Database ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ceo_summit?schema=public"

# ── Redis (cache + Socket.io Pub/Sub) ──
REDIS_URL="redis://localhost:6379"

# ── Auth (NextAuth v5) ──
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ── Salles thématiques — serveur Socket.io autonome (npm run socket:dev) ──
SOCKET_PORT="3001"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# ── Paiement — webhook de confirmation générique (7 août 2026) ──
# Aucun prestataire branché à ce stade (Evolia ou autre) — voir
# app/api/webhooks/payments/route.ts. Coexiste avec la validation manuelle
# admin, ne la remplace pas.
PAYMENT_WEBHOOK_SECRET="ask-ceo-summit-for-sandbox-hmac-secret"

# ── Email transactionnel — Resend ──
RESEND_API_KEY="re_xxxxxxxxxxxx"
EMAIL_FROM="noreply@ceosummit.mg"
ADMIN_ALERT_EMAIL="admin@ceosummit.mg"
# Webhook entrant "taux d'ouverture" (E8-T09) — schéma HMAC simplifié, voir
# app/api/webhooks/resend/route.ts pour la note sur Svix vs ce projet.
RESEND_WEBHOOK_SECRET="ask-ceo-summit-for-sandbox-hmac-secret"

# ── SMS transactionnel — Befiana (gestion corporate, 7 août 2026) ──
BEFIANA_API_KEY="ask-ceo-summit-for-befiana-api-key"

# ── Stockage fichiers — Cloudflare R2 (S3-compatible) ──
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_AVATARS="ceo-summit-avatars"
R2_BUCKET_DOCUMENTS="ceo-summit-documents"
R2_BUCKET_EVENTS="ceo-summit-event-assets"
R2_PUBLIC_URL="https://assets.ceosummit.mg"

# ── Zoom (webinaires) ──
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# ── Messages privés — chiffrement pgcrypto ──
MESSAGE_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# ── App ──
NODE_ENV="development"
