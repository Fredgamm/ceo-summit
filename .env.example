# ── Database ──
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ceo_summit?schema=public"

# ── Redis (cache + Socket.io Pub/Sub) ──
REDIS_URL="redis://localhost:6379"

# ── Auth (NextAuth v5) ──
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# ── Salles thématiques — serveur Socket.io autonome (npm run socket:dev) ──
SOCKET_PORT="3001"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"

# ── Paiement — webhook de confirmation générique (7 août 2026) ──
# Evolia confirme ici les paiements carte / Mobile Money — voir
# app/api/webhooks/payments/route.ts. Coexiste avec la validation manuelle
# admin, ne la remplace pas.
PAYMENT_WEBHOOK_SECRET="ask-ceo-summit-for-sandbox-hmac-secret"

# ── Evolia — push des inscriptions et participants (8 oct. 2026) ──
# Secret HMAC fourni par Evolia : signe nos envois (X-Webhook-Signature:
# sha256=<hex>). Sans lui, les envois sont journalisés en échec et le
# paiement par carte / Mobile Money est refusé (virement toujours possible).
EVOLIA_WEBHOOK_SECRET="ask-evolia-for-hmac-secret"
# Ces valeurs (et PAYMENT_WEBHOOK_SECRET) peuvent aussi être saisies dans
# /admin/parametres › Intégrations, prioritaires sur ce fichier (21 oct. 2026).
# Facultatifs — valeurs par défaut de lib/evolia-config.ts :
# EVOLIA_REGISTRATION_URL="https://api-event.aiolia.us/integration/ceosummit/registrations"
# EVOLIA_PAYMENT_URL="https://event.aiolia.us/ceosummit/payment/{ceoSummitReference}"

# ── Email transactionnel — SMTP (boîte mail existante de ceo-summit.mg) ──
# Sans SMTP_HOST/SMTP_USER/SMTP_PASSWORD réels (placeholders ci-dessous,
# comportement par défaut en dev), lib/resend.ts route automatiquement les
# emails vers Maildev (SMTP local sans authentification) plutôt que
# d'essayer un vrai envoi : lancer `npx maildev` et ouvrir
# http://localhost:1080 pour les voir. Forçable explicitement avec
# MAIL_DEV_MODE=true même si des identifiants réels sont présents.
# En production (NODE_ENV=production), plus de repli automatique sur
# Maildev : sans SMTP réel, l'envoi échoue avec une erreur explicite.
# Expéditeur : EMAIL_FROM, sinon SMTP_USER, sinon noreply@ceo-summit.mg.
SMTP_HOST="smtp.exemple.mg"
SMTP_PORT="465"
SMTP_USER="noreply@ceo-summit.mg"
SMTP_PASSWORD="mot-de-passe-de-la-boite-mail"
# MAIL_DEV_MODE="true"
EMAIL_FROM="noreply@ceo-summit.mg"
ADMIN_ALERT_EMAIL="admin@ceo-summit.mg"

# ── SMS transactionnel — Befiana (gestion corporate, 7 août 2026) ──
BEFIANA_API_KEY="ask-ceo-summit-for-befiana-api-key"

# ── Stockage fichiers — Cloudflare R2 (S3-compatible) ──
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_AVATARS="ceo-summit-avatars"
R2_BUCKET_DOCUMENTS="ceo-summit-documents"
R2_BUCKET_EVENTS="ceo-summit-event-assets"
R2_PUBLIC_URL="https://assets.ceo-summit.mg"

# ── Zoom (webinaires) ──
ZOOM_ACCOUNT_ID=""
ZOOM_CLIENT_ID=""
ZOOM_CLIENT_SECRET=""

# ── Messages privés — chiffrement pgcrypto ──
MESSAGE_ENCRYPTION_KEY="generate-with-openssl-rand-hex-32"

# ── App ──
NODE_ENV="development"
