// CEO Summit Platform — Database schema
// PostgreSQL 16 · Prisma 5
// Ref: /v2-ecosystem-2026/specs-dev/CEO_Summit_Architecture_Technique.docx

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════

/// RBAC access level — checked by middleware on every protected route.
enum Role {
  GUEST
  MEMBER
  EXECUTIVE
  CHAIRMAN
  ADMIN
}

/// Legacy tier bucket — still the type of `Event.minTier`/`Opportunity.visibility`/
/// `MembershipApplication.requestedTier` (non-nullable legacy columns) and the
/// unit `Room.minTier`/RBAC checks compare against. Superseded by the dynamic
/// `Plan` model (Phase 1 of the offers/payment rework, 30 juillet 2026); the
/// effective tier of a user is now derived from their company's plan rank
/// (CEO Summit devenu intégralement B2B, 4 août 2026 — voir
/// lib/plan-access.ts::getViewerTierFromCompany) rather than stored per-user.
enum Tier {
  MEMBER
  EXECUTIVE
  CHAIRMAN
}

enum MembershipStatus {
  PENDING_ACTIVATION
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REFUSED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

/// Matches the category tabs on wireframe/evenements.html.
enum EventType {
  SUMMIT
  DINER
  WEBINAIRE
  RENCONTRE
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  WAITLIST
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// E3-T03 — "virement / mobile money / gratuit si inclus".
enum EventPaymentMethod {
  VIREMENT
  MOBILE_MONEY
  INCLUS
}

enum OpportunityStatus {
  PENDING_MODERATION
  PUBLISHED
  CHANGES_REQUESTED
  REFUSED
  UNPUBLISHED
  EXPIRED
}

enum ContactStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum CreditTransactionType {
  INCLUDED_GRANT
  PURCHASE
  DEDUCTION
  ADMIN_GRANT
  REFUND
}

enum RoomAccessLevel {
  ALL_MEMBERS
  EXECUTIVE_PLUS
  CHAIRMAN_ONLY
}

enum RoomStatus {
  ACTIVE
  ARCHIVED
}

enum ReportStatus {
  PENDING
  RESOLVED_DELETED
  RESOLVED_WARNED
  RESOLVED_EXCLUDED
  DISMISSED
}

enum ServiceStatus {
  DRAFT
  PENDING_MODERATION
  PUBLISHED
  REFUSED
}

enum AdminRole {
  SUPER_ADMIN
  MODERATEUR
  FINANCIER
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  REJECTED_INVALID_SIGNATURE
}

// ═══════════════════════════════════════════════
// AUTH & USERS
// ═══════════════════════════════════════════════

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  title        String? // ex: "CEO", "Directeur Général"
  bio          String?  @db.Text
  avatarUrl    String?
  linkedinUrl  String?
  phone        String?
  country      String?
  sectors      String[] // secteurs d'intérêt (référentiel dans AdminSettings)

  role            Role             @default(MEMBER)
  /// Split off `role` (Phase 0, 30 juillet 2026) — `role` used to double as
  /// both "is this account an admin" and a denormalized tier cache, synced
  /// by two independent write paths that had to stay in lockstep by
  /// convention only. This is now the single source of truth for the admin
  /// axis; `role` stays populated for compatibility during the Tier->Plan
  /// transition but nothing new should read it as an admin check.
  isPlatformAdmin Boolean          @default(false)
  status          MembershipStatus @default(PENDING_ACTIVATION)

  /// Phase 2ter (1er août 2026) — offre choisie sur le site public avant
  /// inscription (lien profond `/inscription?offre=<slug>`), portée jusqu'à
  /// /paiement-en-attente pour ne pas la redemander. Transitoire : jamais
  /// nettoyé explicitement une fois le vrai CompanySubscription créé, mais
  /// plus lu à partir de ce moment-là.
  intendedPlanId String?
  intendedPlan   Plan?   @relation("IntendedPlan", fields: [intendedPlanId], references: [id])

  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id])
  /// Phase 2 offres/paiement — non-null uniquement si ce User est l'admin
  /// fonctionnel d'une entreprise (voir Company.companyAdminId).
  companyAdminOf Company? @relation("CompanyAdmin")

  sponsorId String? // parrain (RG parrainage cercle privé)
  sponsor   User?   @relation("Sponsorship", fields: [sponsorId], references: [id])
  sponsees  User[]  @relation("Sponsorship")

  emailVerifiedAt       DateTime?
  /// Set once the /bienvenue tutorial (E1-T05) is completed or explicitly
  /// skipped — gates whether it re-triggers on subsequent logins.
  onboardingCompletedAt DateTime?
  /// E8-T04 — internal admin note on this member, visible only in /admin/membres/[id].
  adminNote             String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  eventRegistrations           EventRegistration[]
  opportunitiesAuthored        Opportunity[]        @relation("OpportunityAuthor")
  opportunityContactsInitiated OpportunityContact[] @relation("ContactInitiator")
  opportunityContactsReceived  OpportunityContact[] @relation("ContactReceiver")
  creditBalance                CreditBalance?
  creditTransactions           CreditTransaction[]
  creditPurchases              CreditPurchase[]
  roomMessages                 RoomMessage[]
  sentMessages                 Message[]            @relation("MessageSender")
  conversationsAsMember1       Conversation[]       @relation("ConversationMember1")
  conversationsAsMember2       Conversation[]       @relation("ConversationMember2")
  serviceListings              ServiceListing[]
  activationTokens             ActivationToken[]
  passwordResetTokens          PasswordResetToken[]
  reportsFiled                 RoomReport[]         @relation("ReportedBy")
  auditLogsAsAdmin             AuditLog[]           @relation("AuditActor")

  @@index([email])
  @@index([role, status])
  @@index([companyId])
}

model AdminUser {
  id          String    @id @default(cuid())
  userId      String    @unique
  role        AdminRole @default(MODERATEUR)
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([role])
}

model ActivationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime // 72h from creation
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime // 1h from creation
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

// ═══════════════════════════════════════════════
// MEMBERSHIP & CANDIDATURES
// ═══════════════════════════════════════════════

model MembershipApplication {
  id            String            @id @default(cuid())
  fullName      String
  email         String
  companyName   String
  title         String
  sector        String
  country       String
  /// Rendu optionnel (30 juillet 2026) — le formulaire /demande-acces ne
  /// collecte plus de message de motivation, formulaire simplifié. Reste
  /// nullable plutôt que supprimé : les candidatures historiques gardent
  /// leur texte.
  motivation    String?           @db.Text
  /// Parrainage jamais activé (30 juillet 2026) — champ retiré du
  /// formulaire, gardé nullable pour l'historique.
  sponsorName   String?
  attachments   String[] // R2 URLs (CV, lettre de motivation...)
  requestedTier Tier              @default(MEMBER)
  status        ApplicationStatus @default(PENDING)
  adminNote     String?           @db.Text
  decidedById   String?
  decidedAt     DateTime?
  /// Horodatage du consentement RGPD à la collecte (case CGU/politique de
  /// confidentialité cochée sur /demande-acces) — preuve du consentement,
  /// pas juste un booléen : audit conformité du 29 juillet 2026.
  consentedAt   DateTime
  createdAt     DateTime          @default(now())

  @@index([status])
  @@index([email])
}

/// 4 août 2026 (split plateforme/évènement) — mode de facturation d'une
/// offre d'évènement. Sans objet pour une offre plateforme (`Plan.eventId`
/// nul), qui ne se vend jamais directement.
enum PlanPricingMode {
  PER_PARTICIPANT
  FIXED_BUNDLE
  /// 14 septembre 2026 — tarif dégressif par taille de groupe : prix
  /// unitaire par participant qui dépend du palier atteint (voir
  /// `PlanPriceBracket`), applicable à toute offre comme les deux autres
  /// modes.
  TIERED_GROUP
}

/// 14 septembre 2026 — un palier d'une offre en mode `TIERED_GROUP` : tous
/// les participants déclarés sont facturés au prix unitaire du palier dans
/// lequel tombe leur nombre total (ex. 10-29 participants -> 650 Ar/pers.,
/// 30 et plus -> 500 Ar/pers.). `unitPriceEur`/`unitPriceAr` suivent la même
/// convention que `Plan.priceEur`/`priceAr` (3 septembre 2026) : quand
/// `unitPriceEur` est renseigné, `unitPriceAr` est recalculé côté serveur au
/// taux du jour (lib/currency-conversion.ts) et n'est jamais lu que pour
/// l'affichage — le montant dû (lib/company-payment-amount.ts) est toujours
/// `unitPriceAr × declaredParticipants`.
model PlanPriceBracket {
  id              String   @id @default(cuid())
  planId          String
  plan            Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// Borne basse incluse (ex. 10).
  minParticipants Int
  /// Borne haute incluse ; `null` = palier ouvert ("30 et plus").
  maxParticipants Int?
  unitPriceAr     Int
  unitPriceEur    Int?
  displayOrder    Int      @default(0)
  createdAt       DateTime @default(now())

  @@index([planId])
}

/// Admin-creatable offer/plan — replaces the fixed `Tier` enum as the source
/// of truth for membership level, pricing, and included Deal Room credits
/// (Phase 1 of the offers/payment rework, 30 juillet 2026). `rank` is the
/// canonical ordering used for "minimum plan to access X" checks, converging
/// what used to be two separately-hardcoded arrays
/// (lib/deal-room-query.ts::TIER_ORDER, lib/utils.ts::TIER_RANK).
model Plan {
  id                   String           @id @default(cuid())
  name                 String
  /// Phase 2ter (1er août 2026) — identifiant lisible pour le lien profond
  /// depuis le site public vitrine (`/inscription?offre=<slug>`), plutôt que
  /// l'id cuid technique. Éditable dans /admin/plans.
  slug                 String           @unique
  description          String?          @db.Text
  /// Prix unitaire, en Ariary — reste la valeur lue par tout calcul de
  /// montant dû (lib/company-payment-amount.ts) et toute comparaison de
  /// preuve de paiement. Pour une offre d'évènement (`eventId` non nul) en
  /// mode `pricingMode: PER_PARTICIPANT`, prix par participant (montant dû =
  /// priceAr × nombre déclaré) ; en mode `FIXED_BUNDLE`, montant total fixe
  /// pour `includedSeats` sièges.
  priceAr              Int
  /// 3 septembre 2026 (catalogue de sponsoring en euros) — prix officiel
  /// pour une offre cotée en euros ; `priceAr` est alors une estimation
  /// dérivée d'un taux de change au moment de la création/modification de
  /// l'offre (lib/currency-conversion.ts), recalculée à la demande par
  /// l'admin — jamais lue pour un calcul de montant dû, seulement pour
  /// l'affichage informatif "≈ X Ar". `null` pour une offre restée cotée
  /// directement en Ariary (comportement historique, inchangé).
  priceEur             Int?
  /// Quota de collaborateurs de l'avantage **plateforme** (offre avec
  /// `eventId` nul) — indépendant de toute édition d'évènement. Pour une
  /// offre d'évènement, lire ce champ sur `linkedPlatformPlan`, jamais sur
  /// l'offre d'évènement elle-même (4 août 2026, split plateforme/évènement).
  maxTeamMembers       Int?
  /// Seuil minimum de participants pour bénéficier du tarif dégressif en
  /// mode `PER_PARTICIPANT` (ex. Groupement +10 pers exige ≥11
  /// collaborateurs déclarés). Sans objet en mode `FIXED_BUNDLE`. `null` =
  /// aucun seuil.
  minParticipants      Int?
  /// 4 août 2026 (split plateforme/évènement), généralisé le 3 septembre
  /// 2026 à toute offre (plus seulement les offres d'évènement) — mode de
  /// facturation : `PER_PARTICIPANT` (priceAr × nombre déclaré) ou
  /// `FIXED_BUNDLE` (priceAr fixe, éventuellement pour `includedSeats`
  /// sièges sur une offre d'évènement — une offre plateforme utilise plutôt
  /// `maxTeamMembers`, son quota permanent). `null` = comportement
  /// historique (équivalent à `PER_PARTICIPANT` dans computeDueAmount).
  pricingMode          PlanPricingMode?
  /// Nombre de sièges inclus dans le forfait d'une offre d'évènement en mode
  /// `FIXED_BUNDLE` — sur une offre plateforme, `maxTeamMembers` suffit déjà
  /// à représenter ce quota, ce champ n'a pas besoin d'être renseigné.
  includedSeats        Int?
  /// 4 août 2026 (split plateforme/évènement) — référence, pour une offre
  /// d'évènement (`eventId` non nul), vers l'offre plateforme (`eventId`
  /// nul) dont hériter les avantages permanents (crédits, quotas) à la
  /// confirmation du paiement. `null` sur une offre plateforme elle-même.
  linkedPlatformPlanId String?
  linkedPlatformPlan   Plan?            @relation("PlatformPlanLink", fields: [linkedPlatformPlanId], references: [id])
  eventOffers          Plan[]           @relation("PlatformPlanLink")
  includedCredits      Int              @default(0)
  /// Replaces the scattered `=== "CHAIRMAN"` unlimited-credits checks.
  hasUnlimitedCredits  Boolean          @default(false)
  rank                 Int
  eligibilityNote      String?          @db.Text
  isActive             Boolean          @default(true)
  /// Phase 2ter (1er août 2026) — offres de sponsoring créées pour le suivi
  /// admin mais sans parcours self-service (aucun prix public, deal négocié
  /// manuellement) : exclues de getActivePlans({selfServiceOnly:true}) et de
  /// la résolution de lien profond, mais toujours listées à l'admin.
  isSelfService        Boolean          @default(true)
  displayOrder         Int              @default(0)
  /// Phase 2quater (1er août 2026) — rattache cette offre à un évènement
  /// précis (ex. les pass "Engagement 2025 — CEO Summit") plutôt qu'à la
  /// plateforme en général. `null` = offre standard plateforme (mécanisme
  /// de renouvellement une fois les crédits d'une offre d'évènement
  /// épuisés). Payer une offre d'évènement crée automatiquement la ou les
  /// `EventRegistration` correspondantes à la confirmation admin — voir
  /// app/actions/admin-memberships.ts::confirmMembershipPayment et
  /// app/actions/admin-companies.ts::confirmCompanyPayment.
  eventId              String?
  event                Event?           @relation("EventOffers", fields: [eventId], references: [id])
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  usersIntending                User[]                @relation("IntendedPlan")
  eventsAsMinPlan               Event[]               @relation("EventMinPlan")
  opportunitiesAsVisibilityPlan Opportunity[]         @relation("OpportunityVisibilityPlan")
  companySubscriptions          CompanySubscription[]
  eventRegistrations            EventRegistration[]
  priceBrackets                 PlanPriceBracket[]

  @@index([isActive, displayOrder])
  @@index([eventId])
  @@index([linkedPlatformPlanId])
}

model Company {
  id             String   @id @default(cuid())
  name           String
  sector         String
  country        String
  description    String?  @db.Text
  logoUrl        String?
  website        String?
  /// Coordonnées (parcours revu, 1er août 2026).
  phone          String?
  address        String?
  /// Réseaux sociaux — clé libre (ex: "linkedin", "facebook") -> URL, plutôt
  /// que des colonnes par plateforme : le formulaire ne fixe pas une liste
  /// fermée de réseaux.
  socialLinks    Json?
  additionalInfo String?  @db.Text
  createdAt      DateTime @default(now())

  /// Phase 2 offres/paiement (30 juillet 2026) — le créateur de la fiche
  /// entreprise devient admin entreprise par défaut (rôle fonctionnel,
  /// indépendant de son titre réel) ; réassignable depuis le back-office
  /// (app/actions/admin-companies.ts::reassignCompanyAdmin).
  companyAdminId String? @unique
  companyAdmin   User?   @relation("CompanyAdmin", fields: [companyAdminId], references: [id])

  users           User[]
  serviceListings ServiceListing[]
  subscription    CompanySubscription?
  invites         CompanyInvite[]

  @@index([sector])
  @@index([country])
}

enum CompanySubscriptionStatus {
  DRAFT
  PENDING_PAYMENT
  PENDING_REVIEW
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

/// Phase 2 offres/paiement — abonnement d'une entreprise à un Plan
/// (scope: COMPANY). Statut scindé entre l'abonnement (ce modèle) et la
/// tentative de paiement (CompanyPayment) en miroir volontaire du pattern
/// déjà en place EventRegistration.status/.paymentStatus.
model CompanySubscription {
  id                   String                    @id @default(cuid())
  companyId            String                    @unique
  company              Company                   @relation(fields: [companyId], references: [id])
  planId               String
  plan                 Plan                      @relation(fields: [planId], references: [id])
  status               CompanySubscriptionStatus @default(DRAFT)
  startDate            DateTime?
  endDate              DateTime?
  /// 4 août 2026 (RG-04/RG-11) — nombre de participants déclaré par
  /// l'entreprise pour une offre `PER_PARTICIPANT`, source de vérité du
  /// montant dû (pas le headcount réel — voir lib/company-payment-amount.ts).
  /// Renseigné à la soumission de la preuve, verrouillé jusqu'à un
  /// changement d'offre ou une nouvelle soumission. `null` avant
  /// soumission, ou toujours pour une offre `FIXED_BUNDLE` (le nombre de
  /// sièges vient de `Plan.includedSeats`, pas d'ici).
  declaredParticipants Int?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  payments CompanyPayment[]

  @@index([status])
}

enum PaymentMethod {
  VIREMENT
  CHEQUE
  CARTE_BANCAIRE
  MOBILE_MONEY
}

enum PaymentReviewStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// Phase 2 offres/paiement — une tentative de paiement pour un
/// CompanySubscription. Tous les modes passent par la revue manuelle admin
/// en V1 (y compris carte bancaire — décision produit du 30 juillet 2026,
/// pas de gateway intégré pour l'instant).
model CompanyPayment {
  id                    String              @id @default(cuid())
  companySubscriptionId String
  companySubscription   CompanySubscription @relation(fields: [companySubscriptionId], references: [id])
  amount                Int
  method                PaymentMethod
  proofFileKey          String // clé R2 privée — preuve de paiement uploadée
  comment               String?             @db.Text
  status                PaymentReviewStatus @default(PENDING)
  submittedById         String
  reviewedById          String?
  reviewedAt            DateTime?
  rejectionReason       String?             @db.Text
  createdAt             DateTime            @default(now())

  @@index([status])
}

enum CompanyInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/// Phase 2 offres/paiement — invitation d'un collaborateur par l'admin
/// entreprise. Devient un vrai User (companyId prérempli) via le même
/// mécanisme ActivationToken que l'inscription self-service, à l'acceptation.
model CompanyInvite {
  id          String              @id @default(cuid())
  companyId   String
  company     Company             @relation(fields: [companyId], references: [id])
  email       String
  name        String
  invitedById String
  token       String              @unique
  status      CompanyInviteStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  acceptedAt  DateTime?

  @@index([companyId, status])
}

// ═══════════════════════════════════════════════
// ÉVÉNEMENTS
// ═══════════════════════════════════════════════

model Event {
  id            String      @id @default(cuid())
  title         String
  type          EventType   @default(RENCONTRE)
  description   String      @db.Text
  speakers      Json? // [{ name, title, company, photoUrl }]
  location      String
  isOnline      Boolean     @default(false)
  zoomMeetingId String?
  date          DateTime
  capacity      Int
  minTier       Tier        @default(MEMBER)
  /// Phase 1 offres dynamiques (30 juillet 2026) — remplace `minTier` à
  /// terme. Nullable : un événement créé avant cette migration retombe sur
  /// `minTier` (comparaison par rang legacy) tant qu'il n'est pas réédité.
  minPlanId     String?
  minPlan       Plan?       @relation("EventMinPlan", fields: [minPlanId], references: [id])
  price         Int         @default(0) // 0 = inclus dans membership
  imageUrl      String?
  status        EventStatus @default(DRAFT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  registrations EventRegistration[]
  /// Phase 2quater (1er août 2026) — catalogue d'offres propre à cet
  /// évènement (ex. Executive pass, Light/Medium/Premium/Ultimate
  /// corporate), créées librement par l'admin depuis /admin/plans.
  offers        Plan[]              @relation("EventOffers")
  /// E10 — agenda dynamique multi-salles (5 août 2026), remplace l'ancien
  /// champ `program` (JSON libre, {jour, lignes de texte}) par des sessions
  /// structurées avec horaire et salle/piste — plusieurs sessions peuvent
  /// couvrir le même créneau dans des salles différentes (voir
  /// EventSession). Affichage seul pour l'instant : pas d'inscription ni de
  /// check-in par session (nécessiterait un modèle d'inscription dédié).
  sessions      EventSession[]
  /// Contrôle d'accès multi-points (7 août 2026, demande client 3ème
  /// édition) — postes de scan distincts (ex. "Entrée VIP", "Entrée Staff")
  /// pour un même évènement, voir EventCheckpoint.
  checkpoints   EventCheckpoint[]

  @@index([status, date])
  @@index([type])
  @@index([minPlanId])
}

/// E10 — agenda dynamique multi-salles (5 août 2026). Une session est un
/// créneau dans une salle/piste donnée ; plusieurs sessions du même
/// évènement peuvent partager le même horaire dans des salles différentes
/// (ateliers parallèles). `room` reste une chaîne libre — ce n'est pas une
/// relation vers le modèle `Room` des salles thématiques permanentes
/// (concept différent : discussion continue vs créneau ponctuel).
model EventSession {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  room        String
  startTime   DateTime
  endTime     DateTime
  /// Même forme que Event.speakers : [{ name, title, company }].
  speakers    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId, startTime])
}

/// Contrôle d'accès multi-points (7 août 2026, demande client 3ème édition)
/// — un évènement peut avoir plusieurs postes de scan physiquement
/// distincts (ex. "Entrée VIP", "Entrée Staff", "Entrée principale"), gérés
/// librement par l'admin depuis la fiche évènement. Chaque check-in
/// (EventRegistration.checkpointId) enregistre par lequel un participant est
/// effectivement entré — un badge ne peut être validé qu'une fois au total
/// pour l'évènement (pas un check-in par poste), le poste sert au comptage
/// et au reporting, pas à restreindre quel badge peut entrer où.
model EventCheckpoint {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  registrations EventRegistration[]

  @@index([eventId])
}

model EventRegistration {
  id            String              @id @default(cuid())
  eventId       String
  event         Event               @relation(fields: [eventId], references: [id])
  userId        String
  user          User                @relation(fields: [userId], references: [id])
  status        RegistrationStatus  @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus       @default(PENDING)
  paymentMethod EventPaymentMethod?
  paymentRef    String?
  /// Phase 2quater (1er août 2026) — offre d'évènement utilisée (Plan avec
  /// eventId défini). `null` = créée via l'ancien flux simple
  /// (registerForEvent, virement/mobile money, sans preuve).
  planId        String?
  plan          Plan?               @relation(fields: [planId], references: [id])
  badgeQrCode   String              @unique @default(cuid())
  checkedIn     Boolean             @default(false)
  checkedInAt   DateTime?
  /// Contrôle d'accès multi-points (7 août 2026) — quel poste a effectué le
  /// check-in, renseigné uniquement quand checkedIn passe à true.
  checkpointId  String?
  checkpoint    EventCheckpoint?    @relation(fields: [checkpointId], references: [id])
  createdAt     DateTime            @default(now())

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([badgeQrCode])
  @@index([planId])
  @@index([checkpointId])
}

// ═══════════════════════════════════════════════
// DEAL ROOM & CRÉDITS
// ═══════════════════════════════════════════════

model Opportunity {
  id               String            @id @default(cuid())
  authorId         String
  author           User              @relation("OpportunityAuthor", fields: [authorId], references: [id])
  title            String
  /// Chaîne libre validée contre `Referential(type: "opportunity_type")`
  /// (5 août 2026 — était l'enum `OpportunityType`, retiré : le référentiel
  /// admin-éditable en est désormais l'unique source, comme `sector`/
  /// `country` juste en dessous). Stocke directement le libellé affiché
  /// ("Partenariat", pas un code SCREAMING_CASE) — voir la migration
  /// 20260805..._opportunity_type_to_referential pour le mapping de
  /// conversion des données existantes.
  type             String
  sector           String
  country          String
  description      String            @db.Text
  budget           Int? // Ariary
  deadline         DateTime?
  visibility       Tier              @default(EXECUTIVE) // minimum tier to view
  /// Phase 1 offres dynamiques (30 juillet 2026) — remplace `visibility` à
  /// terme, même logique de repli que `Event.minPlanId`.
  visibilityPlanId String?
  visibilityPlan   Plan?             @relation("OpportunityVisibilityPlan", fields: [visibilityPlanId], references: [id])
  tags             String[]
  attachments      String[] // R2 signed URLs, TTL 24h at generation
  status           OpportunityStatus @default(PENDING_MODERATION)
  moderationNote   String?           @db.Text
  moderatedById    String?
  moderatedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  contacts OpportunityContact[]

  @@index([status, createdAt])
  @@index([sector, country])
  @@index([visibilityPlanId])
}

model OpportunityContact {
  id             String        @id @default(cuid())
  opportunityId  String
  opportunity    Opportunity   @relation(fields: [opportunityId], references: [id])
  initiatorId    String
  initiator      User          @relation("ContactInitiator", fields: [initiatorId], references: [id])
  receiverId     String // = opportunity.authorId, denormalized for query convenience
  receiver       User          @relation("ContactReceiver", fields: [receiverId], references: [id])
  status         ContactStatus @default(PENDING)
  message        String?       @db.Text
  creditsSpent   Int           @default(1)
  conversationId String? // set once accepted and conversation auto-created
  createdAt      DateTime      @default(now())

  @@unique([opportunityId, initiatorId])
  @@index([receiverId, status])
}

model CreditBalance {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  included  Int       @default(0) // reset at each renewal based on tier
  purchased Int       @default(0)
  used      Int       @default(0)
  resetAt   DateTime? // next renewal date
  updatedAt DateTime  @updatedAt

  /// Computed in application layer as (included + purchased - used).
  /// Chairman tier bypasses this check entirely (unlimited).
}

model CreditTransaction {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id])
  amount    Int // positive = credit, negative = debit
  type      CreditTransactionType
  reason    String?
  createdAt DateTime              @default(now())

  @@index([userId, createdAt])
}

model CreditPackPrice {
  id      String @id @default(cuid())
  credits Int    @unique // 1, 5, 10
  priceAr Int
}

enum CreditPurchaseStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// E6-T05 — "Flux paiement (virement ou mobile money) → validation admin →
/// crédits crédités". Kept separate from CreditTransaction, which is an
/// immutable ledger entry only written once a purchase is actually confirmed.
model CreditPurchase {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id])
  credits       Int
  priceAr       Int
  paymentMethod EventPaymentMethod // reused: same virement/mobile_money choice, no new enum needed
  status        CreditPurchaseStatus @default(PENDING)
  confirmedById String?
  confirmedAt   DateTime?
  createdAt     DateTime             @default(now())

  @@index([status])
}

// ═══════════════════════════════════════════════
// MESSAGERIE PRIVÉE
// ═══════════════════════════════════════════════

model Conversation {
  id                  String    @id @default(cuid())
  member1Id           String
  member1             User      @relation("ConversationMember1", fields: [member1Id], references: [id])
  member2Id           String
  member2             User      @relation("ConversationMember2", fields: [member2Id], references: [id])
  opportunityId       String? // set if initiated from a Deal Room contact
  lastMessageAt       DateTime  @default(now())
  /// E7-T03 — "Max 1 email par conversation par heure (anti-spam)".
  lastEmailNotifiedAt DateTime?
  createdAt           DateTime  @default(now())

  messages Message[]

  @@unique([member1Id, member2Id])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  /// Encrypted at rest via pgcrypto (pgp_sym_encrypt/pgp_sym_decrypt, see
  /// lib/message-crypto.ts) — stored as ciphertext bytes, never as plain
  /// text. Decrypted server-side only, never sent encrypted to the client.
  content        Bytes
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ═══════════════════════════════════════════════
// SALLES THÉMATIQUES (temps réel)
// ═══════════════════════════════════════════════

model Room {
  id          String          @id @default(cuid())
  name        String
  description String?
  sector      String
  minTier     RoomAccessLevel @default(ALL_MEMBERS)
  status      RoomStatus      @default(ACTIVE)
  createdAt   DateTime        @default(now())

  messages    RoomMessage[]
  reads       RoomRead[]
  suspensions RoomSuspension[]

  @@index([status])
}

/// E4-T02 — badge "nouveau message" sur /salles : dernière lecture par membre.
/// userId volontairement sans relation (comme moderatedById/confirmedById
/// ailleurs) : toujours consommé à partir de l'id du membre connecté.
model RoomRead {
  id         String   @id @default(cuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id])
  userId     String
  lastReadAt DateTime @default(now())

  @@unique([roomId, userId])
}

/// E4-T04 — "Suspension membre d'une salle (durée configurable)".
model RoomSuspension {
  id             String   @id @default(cuid())
  roomId         String
  room           Room     @relation(fields: [roomId], references: [id])
  userId         String
  reason         String?
  suspendedUntil DateTime
  createdById    String
  createdAt      DateTime @default(now())

  @@index([roomId, userId])
}

model RoomMessage {
  id            String    @id @default(cuid())
  roomId        String
  room          Room      @relation(fields: [roomId], references: [id])
  authorId      String
  author        User      @relation(fields: [authorId], references: [id])
  content       String    @db.Text
  /// R2 key (private bucket), not a URL — resolved to a short-lived signed
  /// URL at broadcast/render time (server/socket-server.ts,
  /// app/salles/[id]/page.tsx). Renamed from `attachmentUrl` — B4, audit
  /// sécurité du 29 juillet 2026.
  attachmentKey String?
  deletedAt     DateTime? // soft-delete, replaced by "[Message supprimé]" client-side
  createdAt     DateTime  @default(now())

  reports RoomReport[]

  @@index([roomId, createdAt])
}

model RoomReport {
  id            String       @id @default(cuid())
  roomMessageId String
  roomMessage   RoomMessage  @relation(fields: [roomMessageId], references: [id])
  reportedById  String
  reportedBy    User         @relation("ReportedBy", fields: [reportedById], references: [id])
  status        ReportStatus @default(PENDING)
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime     @default(now())

  @@index([status])
}

// ═══════════════════════════════════════════════
// CATALOGUE DE SERVICES
// ═══════════════════════════════════════════════

model ServiceListing {
  id          String        @id @default(cuid())
  companyId   String?
  company     Company?      @relation(fields: [companyId], references: [id])
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  title       String
  category    String
  description String        @db.Text
  priceInfo   String?
  gallery     String[]
  status      ServiceStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, category])
}

// ═══════════════════════════════════════════════
// ADMIN — PARAMÈTRES, LOGS, WEBHOOKS
// ═══════════════════════════════════════════════

/// Editable referentials shown in /admin/parametres — Référentiels tab.
model Referential {
  id       String @id @default(cuid())
  type     String // "sector" | "country" | "opportunity_type"
  label    String
  position Int    @default(0)

  @@unique([type, label])
  @@index([type])
}

/// Key/value store for editable pricing shown in /admin/parametres — Tarifs tab.
model PlatformSetting {
  key       String   @id // "membership_price_member", "membership_price_executive"...
  value     String
  updatedAt DateTime @updatedAt
}

model WebhookLog {
  id          String        @id @default(cuid())
  source      String // "evolia" | "resend" | "zoom"
  event       String
  payload     Json
  status      WebhookStatus @default(RECEIVED)
  error       String?
  processedAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([source, status])
}

/// Every admin action is logged here for audit (RGPD + accountability).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String // "candidature.approve", "member.suspend", "opportunity.publish"...
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

// ═══════════════════════════════════════════════
// COMMUNICATIONS & BROADCASTS (E8-T09)
// ═══════════════════════════════════════════════

enum BroadcastSegment {
  ALL_ACTIVE
  CHAIRMAN
  EXECUTIVE
  CUSTOM
}

model Broadcast {
  id             String           @id @default(cuid())
  subject        String
  body           String           @db.Text
  segment        BroadcastSegment
  segmentCountry String?
  segmentSector  String?
  sentById       String
  recipientCount Int
  openCount      Int              @default(0)
  createdAt      DateTime         @default(now())

  recipients BroadcastRecipient[]

  @@index([createdAt])
}

/// Un e-mail par destinataire, gardant l'id Resend pour corréler le webhook
/// d'ouverture (E8-T09 : "taux d'ouverture (webhook Resend)").
model BroadcastRecipient {
  id              String    @id @default(cuid())
  broadcastId     String
  broadcast       Broadcast @relation(fields: [broadcastId], references: [id])
  userId          String
  resendMessageId String?
  openedAt        DateTime?

  @@unique([broadcastId, userId])
  @@index([resendMessageId])
}
