// CEO Summit Platform — Database schema
// PostgreSQL 16 · Prisma 5
// Ref: /v2-ecosystem-2026/specs-dev/CEO_Summit_Architecture_Technique.docx

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ═══════════════════════════════════════════════
// ENUMS
// ═══════════════════════════════════════════════

/// RBAC access level — checked by middleware on every protected route.
enum Role {
  GUEST
  MEMBER
  EXECUTIVE
  CHAIRMAN
  ADMIN
}

/// Legacy tier bucket — still the type of `Event.minTier`/`Opportunity.visibility`/
/// `MembershipApplication.requestedTier` (non-nullable legacy columns) and the
/// unit `Room.minTier`/RBAC checks compare against. Superseded by the dynamic
/// `Plan` model (Phase 1 of the offers/payment rework, 30 juillet 2026); the
/// effective tier of a user is now derived from their company's plan rank
/// (CEO Summit devenu intégralement B2B, 4 août 2026 — voir
/// lib/plan-access.ts::getViewerTierFromCompany) rather than stored per-user.
enum Tier {
  MEMBER
  EXECUTIVE
  CHAIRMAN
}

enum MembershipStatus {
  PENDING_ACTIVATION
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REFUSED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

/// Matches the category tabs on wireframe/evenements.html.
enum EventType {
  SUMMIT
  DINER
  WEBINAIRE
  RENCONTRE
}

enum RegistrationStatus {
  PENDING_PAYMENT
  CONFIRMED
  WAITLIST
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

/// E3-T03 — "virement / mobile money / gratuit si inclus".
enum EventPaymentMethod {
  VIREMENT
  MOBILE_MONEY
  INCLUS
}

enum OpportunityStatus {
  PENDING_MODERATION
  PUBLISHED
  CHANGES_REQUESTED
  REFUSED
  UNPUBLISHED
  EXPIRED
}

enum ContactStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum CreditTransactionType {
  INCLUDED_GRANT
  PURCHASE
  DEDUCTION
  ADMIN_GRANT
  REFUND
}

enum RoomAccessLevel {
  ALL_MEMBERS
  EXECUTIVE_PLUS
  CHAIRMAN_ONLY
}

enum RoomStatus {
  ACTIVE
  ARCHIVED
}

enum ReportStatus {
  PENDING
  RESOLVED_DELETED
  RESOLVED_WARNED
  RESOLVED_EXCLUDED
  DISMISSED
}

enum ServiceStatus {
  DRAFT
  PENDING_MODERATION
  PUBLISHED
  REFUSED
}

enum AdminRole {
  SUPER_ADMIN
  MODERATEUR
  FINANCIER
}

enum WebhookStatus {
  RECEIVED
  PROCESSED
  FAILED
  REJECTED_INVALID_SIGNATURE
}

// ═══════════════════════════════════════════════
// AUTH & USERS
// ═══════════════════════════════════════════════

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  title        String? // ex: "CEO", "Directeur Général"
  bio          String?  @db.Text
  avatarUrl    String?
  linkedinUrl  String?
  websiteUrl   String?
  phone        String?
  country      String?
  sectors      String[] // secteurs d'intérêt (référentiel dans AdminSettings)

  role            Role             @default(MEMBER)
  /// Split off `role` (Phase 0, 30 juillet 2026) — `role` used to double as
  /// both "is this account an admin" and a denormalized tier cache, synced
  /// by two independent write paths that had to stay in lockstep by
  /// convention only. This is now the single source of truth for the admin
  /// axis; `role` stays populated for compatibility during the Tier->Plan
  /// transition but nothing new should read it as an admin check.
  isPlatformAdmin Boolean          @default(false)
  status          MembershipStatus @default(PENDING_ACTIVATION)

  /// Phase 2ter (1er août 2026) — offre choisie sur le site public avant
  /// inscription (lien profond `/inscription?offre=<slug>`), portée jusqu'à
  /// /paiement-en-attente pour ne pas la redemander. Transitoire : jamais
  /// nettoyé explicitement une fois le vrai CompanySubscription créé, mais
  /// plus lu à partir de ce moment-là.
  intendedPlanId String?
  intendedPlan   Plan?   @relation("IntendedPlan", fields: [intendedPlanId], references: [id])

  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id])
  /// Phase 2 offres/paiement — non-null uniquement si ce User est l'admin
  /// fonctionnel d'une entreprise (voir Company.companyAdminId).
  companyAdminOf Company? @relation("CompanyAdmin")

  sponsorId String? // parrain (RG parrainage cercle privé)
  sponsor   User?   @relation("Sponsorship", fields: [sponsorId], references: [id])
  sponsees  User[]  @relation("Sponsorship")

  emailVerifiedAt       DateTime?
  /// Set once the /bienvenue tutorial (E1-T05) is completed or explicitly
  /// skipped — gates whether it re-triggers on subsequent logins.
  onboardingCompletedAt DateTime?
  /// E8-T04 — internal admin note on this member, visible only in /admin/membres/[id].
  adminNote             String?   @db.Text
  /// Audit sécurité (25 septembre 2026) — horodatage du dernier changement
  /// de mot de passe (réinitialisation). Toute session JWT ouverte avant
  /// cette date est refusée par `requireViewer()` (lib/require-viewer.ts),
  /// qui compare à `session.user.loginAt` (auth.config.ts).
  passwordChangedAt     DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  eventRegistrations           EventRegistration[]
  opportunitiesAuthored        Opportunity[]            @relation("OpportunityAuthor")
  opportunityContactsInitiated OpportunityContact[]     @relation("ContactInitiator")
  opportunityContactsReceived  OpportunityContact[]     @relation("ContactReceiver")
  creditBalance                CreditBalance?
  creditTransactions           CreditTransaction[]
  creditPurchases              CreditPurchase[]
  roomMessages                 RoomMessage[]
  sentMessages                 Message[]                @relation("MessageSender")
  conversationsAsMember1       Conversation[]           @relation("ConversationMember1")
  conversationsAsMember2       Conversation[]           @relation("ConversationMember2")
  serviceListings              ServiceListing[]
  activationTokens             ActivationToken[]
  passwordResetTokens          PasswordResetToken[]
  reportsFiled                 RoomReport[]             @relation("ReportedBy")
  auditLogsAsAdmin             AuditLog[]               @relation("AuditActor")
  meetingSlots                 MeetingParticipantSlot[]
  meetingRequestsSent          MeetingBooking[]         @relation("MeetingRequester")
  meetingRequestsReceived      MeetingBooking[]         @relation("MeetingRecipient")

  @@index([email])
  @@index([role, status])
  @@index([companyId])
}

model AdminUser {
  id          String    @id @default(cuid())
  userId      String    @unique
  role        AdminRole @default(MODERATEUR)
  active      Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([role])
}

model ActivationToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime // 72h from creation
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  expiresAt DateTime // 1h from creation
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([token])
}

// ═══════════════════════════════════════════════
// MEMBERSHIP & CANDIDATURES
// ═══════════════════════════════════════════════

model MembershipApplication {
  id            String            @id @default(cuid())
  fullName      String
  email         String
  companyName   String
  title         String
  sector        String
  country       String
  /// Rendu optionnel (30 juillet 2026) — le formulaire /demande-acces ne
  /// collecte plus de message de motivation, formulaire simplifié. Reste
  /// nullable plutôt que supprimé : les candidatures historiques gardent
  /// leur texte.
  motivation    String?           @db.Text
  /// Parrainage jamais activé (30 juillet 2026) — champ retiré du
  /// formulaire, gardé nullable pour l'historique.
  sponsorName   String?
  attachments   String[] // R2 URLs (CV, lettre de motivation...)
  requestedTier Tier              @default(MEMBER)
  status        ApplicationStatus @default(PENDING)
  adminNote     String?           @db.Text
  decidedById   String?
  decidedAt     DateTime?
  /// Horodatage du consentement RGPD à la collecte (case CGU/politique de
  /// confidentialité cochée sur /demande-acces) — preuve du consentement,
  /// pas juste un booléen : audit conformité du 29 juillet 2026.
  consentedAt   DateTime
  createdAt     DateTime          @default(now())

  @@index([status])
  @@index([email])
}

/// Deux modes, et deux seulement (audit du 22 septembre 2026,
/// `conception/12`) :
/// - `FIXED_BUNDLE` — forfait : prix fixe, nombre de places fixé par
///   l'admin sur l'offre (`maxTeamMembers`). Rien n'est demandé à
///   l'acheteur au paiement.
/// - `PER_PARTICIPANT` — groupement : prix par personne à partir de
///   `minParticipants`, seul cas où l'acheteur déclare un effectif.
///
/// Un troisième mode `TIERED_GROUP` (paliers dégressifs au sein d'une même
/// offre, avec un modèle `PlanPriceBracket`) a existé du 14 au 22 septembre
/// 2026 : jamais utilisé par aucune offre, retiré au profit de deux offres
/// groupement distinctes.
enum PlanPricingMode {
  PER_PARTICIPANT
  FIXED_BUNDLE
}

/// Admin-creatable offer/plan — replaces the fixed `Tier` enum as the source
/// of truth for membership level, pricing, and included Deal Room credits
/// (Phase 1 of the offers/payment rework, 30 juillet 2026). `rank` is the
/// canonical ordering used for "minimum plan to access X" checks, converging
/// what used to be two separately-hardcoded arrays
/// (lib/deal-room-query.ts::TIER_ORDER, lib/utils.ts::TIER_RANK).
model Plan {
  id                   String           @id @default(cuid())
  name                 String
  /// Phase 2ter (1er août 2026) — identifiant lisible pour le lien profond
  /// depuis le site public vitrine (`/inscription?offre=<slug>`), plutôt que
  /// l'id cuid technique. Éditable dans /admin/plans.
  slug                 String           @unique
  description          String?          @db.Text
  /// Prix en Ariary — seule valeur lue par tout calcul de montant dû
  /// (lib/company-payment-amount.ts) et toute comparaison de preuve de
  /// paiement. En `FIXED_BUNDLE`, c'est le prix total de l'offre ; en
  /// `PER_PARTICIPANT`, le prix par personne.
  priceAr              Int
  /// 3 septembre 2026 (catalogue de sponsoring en euros) — prix officiel
  /// pour une offre cotée en euros ; `priceAr` est alors une estimation
  /// dérivée d'un taux de change au moment de la création/modification de
  /// l'offre (lib/currency-conversion.ts), recalculée à la demande par
  /// l'admin — jamais lue pour un calcul de montant dû, seulement pour
  /// l'affichage informatif "≈ X Ar". `null` pour une offre restée cotée
  /// directement en Ariary (comportement historique, inchangé).
  priceEur             Int?
  /// **Le** nombre de places d'une offre forfaitaire : combien de
  /// participants l'entreprise pourra inscrire (Bronze = 2, Gold = 6…).
  /// Sans objet en `PER_PARTICIPANT`, où le nombre de places est l'effectif
  /// déclaré et payé. Le champ concurrent `includedSeats` a été fusionné
  /// ici le 22 septembre 2026 (`conception/12` §2.2).
  maxTeamMembers       Int?
  /// Effectif minimum d'une offre groupement (`PER_PARTICIPANT`) : en
  /// dessous, l'offre n'est pas proposée ; au-dessus, le prix par personne
  /// reste identique. Sans objet en `FIXED_BUNDLE`.
  minParticipants      Int?
  /// Mode de facturation — voir `PlanPricingMode`. Nullable pour les offres
  /// héritées d'avant le 3 septembre 2026 ; `null` est traité comme
  /// `FIXED_BUNDLE` depuis l'audit du 22 septembre, pour qu'une offre sans
  /// mode explicite ne se facture jamais à la personne par accident
  /// (`conception/12` §2.1).
  pricingMode          PlanPricingMode?
  /// 4 août 2026 (split plateforme/évènement) — référence, pour une offre
  /// d'évènement (`eventId` non nul), vers l'offre plateforme (`eventId`
  /// nul) dont hériter les avantages permanents (crédits, quotas) à la
  /// confirmation du paiement. `null` sur une offre plateforme elle-même.
  linkedPlatformPlanId String?
  linkedPlatformPlan   Plan?            @relation("PlatformPlanLink", fields: [linkedPlatformPlanId], references: [id])
  eventOffers          Plan[]           @relation("PlatformPlanLink")
  includedCredits      Int              @default(0)
  /// Replaces the scattered `=== "CHAIRMAN"` unlimited-credits checks.
  hasUnlimitedCredits  Boolean          @default(false)
  rank                 Int
  eligibilityNote      String?          @db.Text
  isActive             Boolean          @default(true)
  /// Phase 2ter (1er août 2026) — offres de sponsoring créées pour le suivi
  /// admin mais sans parcours self-service (aucun prix public, deal négocié
  /// manuellement) : exclues de getActivePlans({selfServiceOnly:true}) et de
  /// la résolution de lien profond, mais toujours listées à l'admin.
  isSelfService        Boolean          @default(true)
  /// 22 septembre 2026 (`conception/12` §3.1, `5` — supplément participants)
  /// — offre achetable en quantité, en supplément d'un abonnement déjà
  /// actif (ex. Executive Pass, +1 place par unité), jamais comme offre
  /// principale au checkout initial.
  isUpsell             Boolean          @default(false)
  displayOrder         Int              @default(0)
  /// Phase 2quater (1er août 2026) — rattache cette offre à un évènement
  /// précis (ex. les pass "Engagement 2025 — CEO Summit") plutôt qu'à la
  /// plateforme en général. `null` = offre standard plateforme (mécanisme
  /// de renouvellement une fois les crédits d'une offre d'évènement
  /// épuisés). Module 21 (8 oct. 2026) : offre liée = inscription à
  /// l'événement — les membres des entreprises abonnées sont inscrits dans
  /// la limite des places (lib/event-auto-registration.ts).
  eventId              String?
  event                Event?           @relation("EventOffers", fields: [eventId], references: [id])
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  usersIntending                User[]                @relation("IntendedPlan")
  eventsAsMinPlan               Event[]               @relation("EventMinPlan")
  opportunitiesAsVisibilityPlan Opportunity[]         @relation("OpportunityVisibilityPlan")
  companySubscriptions          CompanySubscription[]
  eventRegistrations            EventRegistration[]
  upsellPayments                CompanyPayment[]      @relation("UpsellPlan")
  partnerInvites                PartnerInvite[]

  @@index([isActive, displayOrder])
  @@index([eventId])
  @@index([linkedPlatformPlanId])
}

model Company {
  id                String   @id @default(cuid())
  name              String
  sector            String
  country           String
  description       String?  @db.Text
  logoUrl           String?
  website           String?
  /// Coordonnées (parcours revu, 1er août 2026).
  phone             String?
  address           String?
  /// Réseaux sociaux — clé libre (ex: "linkedin", "facebook") -> URL, plutôt
  /// que des colonnes par plateforme : le formulaire ne fixe pas une liste
  /// fermée de réseaux.
  socialLinks       Json?
  additionalInfo    String?  @db.Text
  /// 22 septembre 2026 (`conception/12` §3.3) — case « Je participe » : le
  /// gestionnaire qui inscrit l'entreprise et paie n'assiste pas forcément
  /// lui-même à l'évènement (souvent une secrétaire). `false` par défaut —
  /// il ne consomme une place que s'il coche explicitement cette case
  /// depuis la composition de la liste des participants.
  adminParticipates Boolean  @default(false)
  createdAt         DateTime @default(now())

  /// Phase 2 offres/paiement (30 juillet 2026) — le créateur de la fiche
  /// entreprise devient admin entreprise par défaut (rôle fonctionnel,
  /// indépendant de son titre réel) ; réassignable depuis le back-office
  /// (app/actions/admin-companies.ts::reassignCompanyAdmin).
  companyAdminId String? @unique
  companyAdmin   User?   @relation("CompanyAdmin", fields: [companyAdminId], references: [id])

  users           User[]
  serviceListings ServiceListing[]
  subscription    CompanySubscription?
  invites         CompanyInvite[]
  partnerInvite   PartnerInvite?

  @@index([sector])
  @@index([country])
}

enum CompanySubscriptionStatus {
  DRAFT
  PENDING_PAYMENT
  PENDING_REVIEW
  ACTIVE
  EXPIRED
  SUSPENDED
  CANCELLED
}

/// Phase 2 offres/paiement — abonnement d'une entreprise à un Plan
/// (scope: COMPANY). Statut scindé entre l'abonnement (ce modèle) et la
/// tentative de paiement (CompanyPayment) en miroir volontaire du pattern
/// déjà en place EventRegistration.status/.paymentStatus.
model CompanySubscription {
  id                      String                    @id @default(cuid())
  companyId               String                    @unique
  company                 Company                   @relation(fields: [companyId], references: [id])
  planId                  String
  plan                    Plan                      @relation(fields: [planId], references: [id])
  status                  CompanySubscriptionStatus @default(DRAFT)
  startDate               DateTime?
  endDate                 DateTime?
  /// 4 août 2026 (RG-04/RG-11) — nombre de participants déclaré par
  /// l'entreprise pour une offre `PER_PARTICIPANT`, source de vérité du
  /// montant dû (pas le headcount réel — voir lib/company-payment-amount.ts).
  /// Renseigné à la soumission de la preuve, verrouillé jusqu'à un
  /// changement d'offre ou une nouvelle soumission. `null` avant
  /// soumission, ou toujours pour une offre `FIXED_BUNDLE` (le nombre de
  /// sièges vient de `Plan.includedSeats`, pas d'ici).
  declaredParticipants    Int?
  /// 22 septembre 2026 (`conception/12` §3.2, §5) — places achetées en
  /// supplément de l'offre principale, via une ou plusieurs offres
  /// `isUpsell` (ex. 3 Executive Pass = +3). Incrémenté uniquement à la
  /// confirmation admin d'un paiement de supplément — jamais décrémenté
  /// (un supplément payé n'est pas repris). Places totales = quota de
  /// l'offre + ce champ.
  extraSeats              Int                       @default(0)
  /// Module 20 (offres partenaires) — nombre de membres propre à cette
  /// entreprise, fixé par l'admin à l'invitation ; à défaut, celui de l'offre.
  memberLimit             Int?
  /// Module 20 — services apportés en échange d'une offre partenaire (admin seulement).
  counterpart             String?                   @db.Text
  /// Module 18 §4.9 — dernière validation de la liste des participants par le gérant.
  participantsValidatedAt DateTime?
  /// 14 oct. 2026 — offre « Staff » d'un administrateur de la plateforme
  /// (app/actions/staff-offer.ts) : aucun plafond de participants.
  unlimitedSeats          Boolean                   @default(false)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  payments CompanyPayment[]

  @@index([status])
}

enum PaymentMethod {
  VIREMENT
  CHEQUE
  CARTE_BANCAIRE
  MOBILE_MONEY
}

enum PaymentReviewStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// Phase 2 offres/paiement — une tentative de paiement pour un
/// CompanySubscription. Tous les modes passent par la revue manuelle admin
/// en V1 (y compris carte bancaire — décision produit du 30 juillet 2026,
/// pas de gateway intégré pour l'instant).
model CompanyPayment {
  id                    String              @id @default(cuid())
  companySubscriptionId String
  companySubscription   CompanySubscription @relation(fields: [companySubscriptionId], references: [id])
  amount                Int
  method                PaymentMethod
  proofFileKey          String // clé R2 privée — preuve de paiement uploadée
  comment               String?             @db.Text
  status                PaymentReviewStatus @default(PENDING)
  submittedById         String
  reviewedById          String?
  reviewedAt            DateTime?
  rejectionReason       String?             @db.Text
  /// 22 septembre 2026 — non nul uniquement pour l'achat d'un supplément
  /// de participants (offre `Plan.isUpsell`) : `upsellQuantity` unités de
  /// cette offre, en plus de l'abonnement déjà actif. Sa confirmation
  /// n'active pas l'abonnement (déjà actif) et n'y touche pas — elle
  /// incrémente seulement `CompanySubscription.extraSeats`.
  upsellPlanId          String?
  upsellPlan            Plan?               @relation("UpsellPlan", fields: [upsellPlanId], references: [id])
  upsellQuantity        Int?
  /// Rapport QA du 7 oct. 2026 (§4.2) — taux EUR→Ar au moment du paiement,
  /// pour l'export comptable en euros. Nul pour les paiements antérieurs.
  eurToArRate           Float?
  createdAt             DateTime            @default(now())

  @@index([status])
}

enum PartnerInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/// Module 20 (offres partenaires) — invitation d'un gérant par l'admin sur une
/// offre partenaire (montant 0, non proposée à l'inscription). Le gérant crée
/// son compte et son entreprise depuis le lien ; l'abonnement est alors actif
/// sans paiement.
model PartnerInvite {
  id          String              @id @default(cuid())
  name        String
  email       String
  planId      String
  plan        Plan                @relation(fields: [planId], references: [id])
  memberLimit Int?
  counterpart String?             @db.Text
  token       String              @unique
  status      PartnerInviteStatus @default(PENDING)
  expiresAt   DateTime
  invitedById String
  companyId   String?             @unique
  company     Company?            @relation(fields: [companyId], references: [id])
  createdAt   DateTime            @default(now())
  acceptedAt  DateTime?

  @@index([status])
  @@index([email])
}

enum CompanyInviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

/// Phase 2 offres/paiement — invitation d'un collaborateur par l'admin
/// entreprise. Devient un vrai User (companyId prérempli) via le même
/// mécanisme ActivationToken que l'inscription self-service, à l'acceptation.
model CompanyInvite {
  id          String              @id @default(cuid())
  companyId   String
  company     Company             @relation(fields: [companyId], references: [id])
  email       String
  name        String
  /// 20 oct. 2026 — fonction du collaborateur, saisie par le gérant à
  /// l'invitation et reprise sur son compte (transmise à Evolia).
  title       String?
  invitedById String
  token       String              @unique
  status      CompanyInviteStatus @default(PENDING)
  createdAt   DateTime            @default(now())
  acceptedAt  DateTime?
  /// 22 septembre 2026 — invitation qui n'expirait jamais jusqu'ici, ce qui
  /// laissait une invitation jamais acceptée occuper indéfiniment un siège
  /// dans le calcul du plafond (voir inviteTeammate). Défaut posé en
  /// application (lib/tokens.ts::COMPANY_INVITE_TTL_MS).
  expiresAt   DateTime

  @@index([companyId, status])
}

// ═══════════════════════════════════════════════
// ÉVÉNEMENTS
// ═══════════════════════════════════════════════

model Event {
  id            String      @id @default(cuid())
  title         String
  type          EventType   @default(RENCONTRE)
  description   String      @db.Text
  /// Plus saisi ni affiché depuis le module 21 (D18) : les intervenants se
  /// gèrent par session du Programme. Conservé pour ne rien perdre.
  speakers      Json? // [{ name, title, company, photoUrl }]
  location      String
  isOnline      Boolean     @default(false)
  zoomMeetingId String?
  date          DateTime
  /// Intégration Evolia (8 oct. 2026) — fin de l'événement, transmise avec le début.
  endDate       DateTime?
  /// Module 21 D19 (8 oct. 2026) — fuseau IANA dans lequel toutes les heures
  /// de l'événement sont saisies et affichées (voir lib/event-timezone.ts).
  /// Les dates restent stockées en UTC.
  timezone      String      @default("Indian/Antananarivo")
  capacity      Int
  minTier       Tier        @default(MEMBER)
  /// Phase 1 offres dynamiques (30 juillet 2026) — remplace `minTier` à
  /// terme. Nullable : un événement créé avant cette migration retombe sur
  /// `minTier` (comparaison par rang legacy) tant qu'il n'est pas réédité.
  minPlanId     String?
  minPlan       Plan?       @relation("EventMinPlan", fields: [minPlanId], references: [id])
  price         Int         @default(0) // 0 = inclus dans membership
  imageUrl      String?
  status        EventStatus @default(DRAFT)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  registrations EventRegistration[]
  /// Phase 2quater (1er août 2026) — catalogue d'offres propre à cet
  /// évènement (ex. Executive pass, Light/Medium/Premium/Ultimate
  /// corporate), créées librement par l'admin depuis /admin/plans.
  offers        Plan[]              @relation("EventOffers")
  /// E10 — agenda dynamique multi-salles (5 août 2026), remplace l'ancien
  /// champ `program` (JSON libre, {jour, lignes de texte}) par des sessions
  /// structurées avec horaire et salle/piste — plusieurs sessions peuvent
  /// couvrir le même créneau dans des salles différentes (voir
  /// EventSession). Affichage seul pour l'instant : pas d'inscription ni de
  /// check-in par session (nécessiterait un modèle d'inscription dédié).
  sessions      EventSession[]
  /// Contrôle d'accès multi-points (7 août 2026, demande client 3ème
  /// édition) — postes de scan distincts (ex. "Entrée VIP", "Entrée Staff")
  /// pour un même évènement, voir EventCheckpoint.
  checkpoints   EventCheckpoint[]
  /// Module 21 (8 oct. 2026) — créneaux de rendez-vous B2B (networking),
  /// option distincte du Programme (`sessions`).
  meetingSetup  EventMeetingSetup?
  meetingSlots  MeetingTimeSlot[]
  meetings      MeetingBooking[]
  /// Module 21 D17 (8 oct. 2026) — documents téléchargeables, à la place
  /// de la section « Intervenants » (`speakers` reste en base, D18).
  attachments   EventAttachment[]

  @@index([status, date])
  @@index([type])
  @@index([minPlanId])
}

/// E10 — agenda dynamique multi-salles (5 août 2026). Une session est un
/// créneau dans une salle/piste donnée ; plusieurs sessions du même
/// évènement peuvent partager le même horaire dans des salles différentes
/// (ateliers parallèles). `room` reste une chaîne libre — ce n'est pas une
/// relation vers le modèle `Room` des salles thématiques permanentes
/// (concept différent : discussion continue vs créneau ponctuel).
model EventSession {
  id          String   @id @default(cuid())
  eventId     String
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title       String
  description String?  @db.Text
  room        String
  startTime   DateTime
  endTime     DateTime
  /// Même forme que Event.speakers : [{ name, title, company }].
  speakers    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([eventId, startTime])
}

/// Contrôle d'accès multi-points (7 août 2026, demande client 3ème édition)
/// — un évènement peut avoir plusieurs postes de scan physiquement
/// distincts (ex. "Entrée VIP", "Entrée Staff", "Entrée principale"), gérés
/// librement par l'admin depuis la fiche évènement. Chaque check-in
/// (EventRegistration.checkpointId) enregistre par lequel un participant est
/// effectivement entré — un badge ne peut être validé qu'une fois au total
/// pour l'évènement (pas un check-in par poste), le poste sert au comptage
/// et au reporting, pas à restreindre quel badge peut entrer où.
model EventCheckpoint {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  registrations EventRegistration[]

  @@index([eventId])
}

model EventRegistration {
  id            String              @id @default(cuid())
  eventId       String
  event         Event               @relation(fields: [eventId], references: [id])
  userId        String
  user          User                @relation(fields: [userId], references: [id])
  status        RegistrationStatus  @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus       @default(PENDING)
  paymentMethod EventPaymentMethod?
  /// Taux EUR→Ar au moment de l'inscription payante (voir CompanyPayment.eurToArRate).
  eurToArRate   Float?
  paymentRef    String?
  /// Phase 2quater (1er août 2026) — offre d'évènement utilisée (Plan avec
  /// eventId défini). `null` = créée via l'ancien flux simple
  /// (registerForEvent, virement/mobile money, sans preuve).
  planId        String?
  plan          Plan?               @relation(fields: [planId], references: [id])
  badgeQrCode   String              @unique @default(cuid())
  checkedIn     Boolean             @default(false)
  checkedInAt   DateTime?
  /// Contrôle d'accès multi-points (7 août 2026) — quel poste a effectué le
  /// check-in, renseigné uniquement quand checkedIn passe à true.
  checkpointId  String?
  checkpoint    EventCheckpoint?    @relation(fields: [checkpointId], references: [id])
  createdAt     DateTime            @default(now())

  @@unique([eventId, userId])
  @@index([eventId, status])
  @@index([badgeQrCode])
  @@index([planId])
  @@index([checkpointId])
}

// ═══════════════════════════════════════════════
// DEAL ROOM & CRÉDITS
// ═══════════════════════════════════════════════

model Opportunity {
  id               String            @id @default(cuid())
  authorId         String
  author           User              @relation("OpportunityAuthor", fields: [authorId], references: [id])
  title            String
  /// Chaîne libre validée contre `Referential(type: "opportunity_type")`
  /// (5 août 2026 — était l'enum `OpportunityType`, retiré : le référentiel
  /// admin-éditable en est désormais l'unique source, comme `sector`/
  /// `country` juste en dessous). Stocke directement le libellé affiché
  /// ("Partenariat", pas un code SCREAMING_CASE) — voir la migration
  /// 20260805..._opportunity_type_to_referential pour le mapping de
  /// conversion des données existantes.
  type             String
  sector           String
  country          String
  description      String            @db.Text
  budget           Int? // Ariary
  /// Rapport QA du 30 septembre 2026 — budget optionnel saisi en euros,
  /// même logique que Plan.priceEur/priceAr : `budget` (Ariary) reste
  /// l'unique valeur utilisée pour le filtre/tri par budget de la liste
  /// (lib/deal-room-query.ts), `budgetEur` n'est qu'informatif pour
  /// l'affichage "≈ X Ar" quand l'auteur a saisi en €.
  budgetEur        Int?
  deadline         DateTime?
  /// Audit mobile 22 sept. 2026 (conception/14 §3) — défaut aligné sur
  /// l'attendu confirmé (Deal Room accessible à tous par défaut, comme
  /// Event.minTier/Room.minTier) plutôt que sur EXECUTIVE (qui restreignait
  /// une opportunité sans action explicite du créateur). Sans effet observé
  /// à ce jour : le seul site de création (publishOpportunity) envoie déjà
  /// toujours une valeur explicite depuis le formulaire (par défaut MEMBER,
  /// "Tous les membres") — ce défaut ne protège que les futurs chemins de
  /// code qui omettraient de le faire.
  visibility       Tier              @default(MEMBER) // minimum tier to view
  /// Phase 1 offres dynamiques (30 juillet 2026) — remplace `visibility` à
  /// terme, même logique de repli que `Event.minPlanId`.
  visibilityPlanId String?
  visibilityPlan   Plan?             @relation("OpportunityVisibilityPlan", fields: [visibilityPlanId], references: [id])
  tags             String[]
  attachments      String[] // R2 signed URLs, TTL 24h at generation
  status           OpportunityStatus @default(PENDING_MODERATION)
  moderationNote   String?           @db.Text
  moderatedById    String?
  moderatedAt      DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  contacts OpportunityContact[]

  @@index([status, createdAt])
  @@index([sector, country])
  @@index([visibilityPlanId])
}

model OpportunityContact {
  id             String        @id @default(cuid())
  opportunityId  String
  opportunity    Opportunity   @relation(fields: [opportunityId], references: [id])
  initiatorId    String
  initiator      User          @relation("ContactInitiator", fields: [initiatorId], references: [id])
  receiverId     String // = opportunity.authorId, denormalized for query convenience
  receiver       User          @relation("ContactReceiver", fields: [receiverId], references: [id])
  status         ContactStatus @default(PENDING)
  message        String?       @db.Text
  creditsSpent   Int           @default(1)
  conversationId String? // set once accepted and conversation auto-created
  createdAt      DateTime      @default(now())

  @@unique([opportunityId, initiatorId])
  @@index([receiverId, status])
}

model CreditBalance {
  id        String    @id @default(cuid())
  userId    String    @unique
  user      User      @relation(fields: [userId], references: [id])
  included  Int       @default(0) // reset at each renewal based on tier
  purchased Int       @default(0)
  used      Int       @default(0)
  resetAt   DateTime? // next renewal date
  updatedAt DateTime  @updatedAt

  /// Computed in application layer as (included + purchased - used).
  /// Chairman tier bypasses this check entirely (unlimited).
}

model CreditTransaction {
  id        String                @id @default(cuid())
  userId    String
  user      User                  @relation(fields: [userId], references: [id])
  amount    Int // positive = credit, negative = debit
  type      CreditTransactionType
  reason    String?
  createdAt DateTime              @default(now())

  @@index([userId, createdAt])
}

model CreditPackPrice {
  id      String @id @default(cuid())
  credits Int    @unique // 1, 5, 10
  priceAr Int
}

enum CreditPurchaseStatus {
  PENDING
  CONFIRMED
  REJECTED
}

/// E6-T05 — "Flux paiement (virement ou mobile money) → validation admin →
/// crédits crédités". Kept separate from CreditTransaction, which is an
/// immutable ledger entry only written once a purchase is actually confirmed.
model CreditPurchase {
  id            String               @id @default(cuid())
  userId        String
  user          User                 @relation(fields: [userId], references: [id])
  credits       Int
  priceAr       Int
  paymentMethod EventPaymentMethod // reused: same virement/mobile_money choice, no new enum needed
  status        CreditPurchaseStatus @default(PENDING)
  confirmedById String?
  confirmedAt   DateTime?
  createdAt     DateTime             @default(now())

  @@index([status])
}

// ═══════════════════════════════════════════════
// MESSAGERIE PRIVÉE
// ═══════════════════════════════════════════════

model Conversation {
  id                  String    @id @default(cuid())
  member1Id           String
  member1             User      @relation("ConversationMember1", fields: [member1Id], references: [id])
  member2Id           String
  member2             User      @relation("ConversationMember2", fields: [member2Id], references: [id])
  opportunityId       String? // set if initiated from a Deal Room contact
  lastMessageAt       DateTime  @default(now())
  /// E7-T03 — "Max 1 email par conversation par heure (anti-spam)".
  lastEmailNotifiedAt DateTime?
  createdAt           DateTime  @default(now())

  messages Message[]

  @@unique([member1Id, member2Id])
  @@index([lastMessageAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id])
  /// Encrypted at rest via pgcrypto (pgp_sym_encrypt/pgp_sym_decrypt, see
  /// lib/message-crypto.ts) — stored as ciphertext bytes, never as plain
  /// text. Decrypted server-side only, never sent encrypted to the client.
  content        Bytes
  readAt         DateTime?
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

// ═══════════════════════════════════════════════
// SALLES THÉMATIQUES (temps réel)
// ═══════════════════════════════════════════════

model Room {
  id          String          @id @default(cuid())
  name        String
  description String?
  sector      String
  minTier     RoomAccessLevel @default(ALL_MEMBERS)
  status      RoomStatus      @default(ACTIVE)
  createdAt   DateTime        @default(now())

  messages    RoomMessage[]
  reads       RoomRead[]
  suspensions RoomSuspension[]

  @@index([status])
}

/// E4-T02 — badge "nouveau message" sur /salles : dernière lecture par membre.
/// userId volontairement sans relation (comme moderatedById/confirmedById
/// ailleurs) : toujours consommé à partir de l'id du membre connecté.
model RoomRead {
  id         String   @id @default(cuid())
  roomId     String
  room       Room     @relation(fields: [roomId], references: [id])
  userId     String
  lastReadAt DateTime @default(now())

  @@unique([roomId, userId])
}

/// E4-T04 — "Suspension membre d'une salle (durée configurable)".
model RoomSuspension {
  id             String   @id @default(cuid())
  roomId         String
  room           Room     @relation(fields: [roomId], references: [id])
  userId         String
  reason         String?
  suspendedUntil DateTime
  createdById    String
  createdAt      DateTime @default(now())

  @@index([roomId, userId])
}

model RoomMessage {
  id            String    @id @default(cuid())
  roomId        String
  room          Room      @relation(fields: [roomId], references: [id])
  authorId      String
  author        User      @relation(fields: [authorId], references: [id])
  content       String    @db.Text
  /// R2 key (private bucket), not a URL — resolved to a short-lived signed
  /// URL at broadcast/render time (server/socket-server.ts,
  /// app/salles/[id]/page.tsx). Renamed from `attachmentUrl` — B4, audit
  /// sécurité du 29 juillet 2026.
  attachmentKey String?
  deletedAt     DateTime? // soft-delete, replaced by "[Message supprimé]" client-side
  createdAt     DateTime  @default(now())

  reports RoomReport[]

  @@index([roomId, createdAt])
}

model RoomReport {
  id            String       @id @default(cuid())
  roomMessageId String
  roomMessage   RoomMessage  @relation(fields: [roomMessageId], references: [id])
  reportedById  String
  reportedBy    User         @relation("ReportedBy", fields: [reportedById], references: [id])
  status        ReportStatus @default(PENDING)
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime     @default(now())

  @@index([status])
}

// ═══════════════════════════════════════════════
// CATALOGUE DE SERVICES
// ═══════════════════════════════════════════════

model ServiceListing {
  id          String        @id @default(cuid())
  companyId   String?
  company     Company?      @relation(fields: [companyId], references: [id])
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  title       String
  category    String
  description String        @db.Text
  priceInfo   String?
  gallery     String[]
  status      ServiceStatus @default(DRAFT)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status, category])
}

// ═══════════════════════════════════════════════
// ADMIN — PARAMÈTRES, LOGS, WEBHOOKS
// ═══════════════════════════════════════════════

/// Editable referentials shown in /admin/parametres — Référentiels tab.
model Referential {
  id       String @id @default(cuid())
  type     String // "sector" | "country" | "opportunity_type"
  label    String
  position Int    @default(0)

  @@unique([type, label])
  @@index([type])
}

/// Key/value store for editable pricing shown in /admin/parametres — Tarifs tab.
model PlatformSetting {
  key       String   @id // "membership_price_member", "membership_price_executive"...
  value     String
  updatedAt DateTime @updatedAt
}

model WebhookLog {
  id          String        @id @default(cuid())
  source      String // "evolia" | "resend" | "zoom"
  event       String
  payload     Json
  status      WebhookStatus @default(RECEIVED)
  error       String?
  processedAt DateTime?
  createdAt   DateTime      @default(now())

  @@index([source, status])
}

/// Every admin action is logged here for audit (RGPD + accountability).
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation("AuditActor", fields: [actorId], references: [id])
  action     String // "candidature.approve", "member.suspend", "opportunity.publish"...
  targetType String
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([targetType, targetId])
}

// ═══════════════════════════════════════════════
// COMMUNICATIONS & BROADCASTS (E8-T09)
// ═══════════════════════════════════════════════

enum BroadcastSegment {
  ALL_ACTIVE
  CHAIRMAN
  EXECUTIVE
  CUSTOM
}

model Broadcast {
  id             String           @id @default(cuid())
  subject        String
  body           String           @db.Text
  segment        BroadcastSegment
  segmentCountry String?
  segmentSector  String?
  /// Rapport QA du 1er oct. 2026 (§3.2b) — offre(s) ciblée(s) pour un
  /// segment CUSTOM, trace historique de ce qui a été réellement envoyé.
  /// Vide pour tout broadcast antérieur à cette fonctionnalité.
  segmentPlanIds String[]         @default([])
  /// Rapport QA du 1er oct. 2026 (§3.2a) — clés R2 privées des pièces
  /// jointes, résolues en URL signée (BROADCAST_ATTACHMENT_LINK_TTL_SECONDS)
  /// dans le corps de l'email à l'envoi, jamais une URL publique directe.
  attachmentKeys String[]         @default([])
  sentById       String
  recipientCount Int
  openCount      Int              @default(0)
  createdAt      DateTime         @default(now())

  recipients BroadcastRecipient[]

  @@index([createdAt])
}

/// Un e-mail par destinataire, gardant l'id Resend pour corréler le webhook
/// d'ouverture (E8-T09 : "taux d'ouverture (webhook Resend)").
model BroadcastRecipient {
  id              String    @id @default(cuid())
  broadcastId     String
  broadcast       Broadcast @relation(fields: [broadcastId], references: [id])
  userId          String
  resendMessageId String?
  openedAt        DateTime?

  @@unique([broadcastId, userId])
  @@index([resendMessageId])
}

// ═══════════════════════════════════════════════
// BIBLIOTHÈQUE D'EMAILS TRANSACTIONNELS (audit MVP, 25 septembre 2026)
// ═══════════════════════════════════════════════

/// Catégories métier des 36 emails transactionnels — pilote le regroupement
/// dans /admin/emails. Ne couvre pas Broadcast ci-dessus (déjà éditable
/// depuis /admin/communications, pas de doublon d'UI).
enum EmailTemplateCategory {
  ACCOUNT_APPLICATION
  COMPANY_BILLING
  TEAM_COLLABORATORS
  EVENT
  DEAL_ROOM
  ROOM_MODERATION
  SERVICES
  MESSAGING
  ADMIN_ALERT
}

/// Une ligne = un ÉCART par rapport au registre déclaré en code
/// (lib/email-templates/*.ts) — jamais le contenu "normal". Tant qu'aucune
/// ligne n'existe pour une clé, resolveEmail() (lib/email-template-resolver.ts)
/// sert intégralement le contenu par défaut du registre : un email non
/// personnalisé reste pixel-identique à avant cette fonctionnalité.
model EmailTemplateOverride {
  key         String                @id // clé du registre, ex. "company-payment-confirmed"
  category    EmailTemplateCategory
  /// `null` = contenu non personnalisé (seul `isActive` diffère éventuellement).
  subject     String?
  /// `EmailBlock[]` sérialisé (lib/email-blocks.ts) — jamais du HTML brut,
  /// toujours rendu par emails/dynamic-email.tsx via des composants de confiance.
  blocks      Json?
  isActive    Boolean               @default(true)
  updatedById String
  updatedAt   DateTime              @updatedAt
  createdAt   DateTime              @default(now())

  @@index([category])
}

enum EvoliaPushStatus {
  PENDING
  SENT
  FAILED
}

/// Intégration Evolia (conception/11, échange 1) — chaque envoi vers Evolia
/// (inscription à payer, virement validé, liste des participants), avec le
/// corps exact envoyé et la réponse : l'admin voit les échecs et relance.
model EvoliaPush {
  id         String           @id @default(cuid())
  companyId  String
  event      String // "company.registration.pushed" | "company.participants.confirmed"
  reference  String? // ceoSummitReference (CompanyPayment.id) quand il y a un paiement
  payload    Json
  status     EvoliaPushStatus @default(PENDING)
  attempts   Int              @default(0)
  httpStatus Int?
  lastError  String?          @db.Text
  sentAt     DateTime?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([status, createdAt])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Module 21 (8 oct. 2026) — rendez-vous B2B en événement
// (conception/21_rdv_b2b_specification_integration.md). Aucune table
// physique : un rendez-vous relie deux participants sur un créneau, dans la
// zone RDV de l'événement.
// ─────────────────────────────────────────────────────────────────────────────

enum MeetingSetupStatus {
  DRAFT
  PUBLISHED
}

/// Statut d'un créneau de la grille admin. DISABLED : désactivé par l'admin
/// pour tous les participants (§3.0).
enum MeetingSlotStatus {
  DRAFT
  PUBLISHED
  DISABLED
}

/// Disponibilité d'un participant sur un créneau (§3.2). Pas de ligne =
/// inactif (opt-in, D3) ; INACTIVE = désactivé après avoir été activé.
enum MeetingAvailability {
  INACTIVE
  FREE
  PENDING
  BOOKED
}

/// Statut d'une demande / d'un rendez-vous (§3.2). « Terminé » est calculé
/// (D5) : CONFIRMED dont l'heure de fin est passée.
enum MeetingBookingStatus {
  PENDING
  CONFIRMED
  DECLINED
  EXPIRED
  WITHDRAWN
  CANCELLED
}

/// Réglages de l'option « Créneaux rendez-vous » d'un événement (un au plus).
/// La réservation est ouverte de la publication à la fin de l'événement
/// (RG-11) : pas de dates d'ouverture ni de fermeture.
model EventMeetingSetup {
  id                  String             @id @default(cuid())
  eventId             String             @unique
  event               Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Zone RDV (ex. « Espace B2B, niveau 1 ») et indications d'accès, obligatoires.
  zone                String
  accessInstructions  String             @db.Text
  slotDurationMinutes Int                @default(30)
  status              MeetingSetupStatus @default(DRAFT)
  publishedAt         DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
}

model MeetingTimeSlot {
  id               String                   @id @default(cuid())
  eventId          String
  event            Event                    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  startTime        DateTime
  endTime          DateTime
  status           MeetingSlotStatus        @default(DRAFT)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  participantSlots MeetingParticipantSlot[]
  bookings         MeetingBooking[]

  @@unique([eventId, startTime])
  @@index([eventId, status, startTime])
}

/// Créée quand le participant active le créneau (D3). Unique par membre et
/// par créneau. Une demande passe les créneaux des deux participants de
/// FREE à PENDING par une mise à jour conditionnelle (RG-03).
model MeetingParticipantSlot {
  id        String              @id @default(cuid())
  slotId    String
  slot      MeetingTimeSlot     @relation(fields: [slotId], references: [id], onDelete: Cascade)
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    MeetingAvailability @default(FREE)
  /// Demande ou rendez-vous qui bloque ce créneau (PENDING ou BOOKED).
  bookingId String?
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@unique([slotId, userId])
  @@index([userId, status])
}

model MeetingBooking {
  id                String               @id @default(cuid())
  eventId           String
  event             Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slotId            String
  slot              MeetingTimeSlot      @relation(fields: [slotId], references: [id], onDelete: Cascade)
  requesterId       String
  requester         User                 @relation("MeetingRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  recipientId       String
  recipient         User                 @relation("MeetingRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  /// Motif obligatoire, 10 à 500 caractères (RG-08).
  reason            String               @db.Text
  status            MeetingBookingStatus @default(PENDING)
  /// Échéance de réponse (RG-06, D13), calculée à l'envoi.
  expiresAt         DateTime
  respondedAt       DateTime?
  /// Jeton de réponse depuis l'email (V2, RG-15), haché.
  decisionTokenHash String?              @unique
  cancelReason      String?              @db.Text
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([eventId, status])
  @@index([requesterId, status])
  @@index([recipientId, status])
  @@index([slotId])
  @@index([status, expiresAt])
}

/// Module 21 D17 (8 oct. 2026) — pièce jointe d'un événement (PDF, image,
/// Word, Excel, PowerPoint ; 20 Mo, 10 par événement), visible des membres
/// sur la fiche de l'événement. Voir lib/event-attachments.ts.
model EventAttachment {
  id        String   @id @default(cuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  title     String
  url       String
  fileName  String
  mimeType  String
  sizeBytes Int
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([eventId, position])
}
